<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="CellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CellForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="HeaderCellBackgroundBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="HeaderCellForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="StartCellBackgroundBrush" Color="#FFF8DC"/>
    <SolidColorBrush x:Key="StartCellForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="FixedCellBackgroundBrush" Color="#FFF8DC"/>
    <SolidColorBrush x:Key="FixedCellForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#CCCCCC"/>

    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#D6E4F0"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFE4B5"/>
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="ResourceHeaderBrush" Color="#C8E6C9"/>
    <SolidColorBrush x:Key="ResourceHeaderForegroundBrush" Color="#000000"/>

    <SolidColorBrush x:Key="OilCellBackgroundBrush" Color="#FFF8DC"/>
    <SolidColorBrush x:Key="AlertBackgroundBrush" Color="#FFE4B5"/>

    <!-- ==================== ЯЧЕЙКИ-ПРЕДУПРЕЖДЕНИЯ ==================== -->
    <!-- Жёлтый фон / чёрный текст -->
    <SolidColorBrush x:Key="WarningCellBackgroundBrush" Color="Yellow"/>
    <SolidColorBrush x:Key="WarningCellForegroundBrush" Color="Black"/>

    <!-- Красный фон / жёлтый текст -->
    <SolidColorBrush x:Key="CriticalCellBackgroundBrush" Color="Red"/>
    <SolidColorBrush x:Key="CriticalCellForegroundBrush" Color="Yellow"/>

    <!-- Красный текст (без фона) -->
    <SolidColorBrush x:Key="RedTextBrush" Color="Red"/>

    <!-- Каретка ввода текста (чёрная для светлой темы) -->
    <SolidColorBrush x:Key="CaretBrush" Color="#000000"/>

    <DropShadowEffect x:Key="HeaderTextShadow"
                      Color="Black"
                      BlurRadius="2"
                      ShadowDepth="0"
                      Opacity="0.3"/>

</ResourceDictionary>