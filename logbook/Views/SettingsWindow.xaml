<Window x:Class="logbook.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource CellBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource CellForegroundBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource CellBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderCellBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderCellBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" TabStripPlacement="Left"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">

            <!-- ==================== ИНТЕРФЕЙС ==================== -->
            <TabItem Header="{DynamicResource Settings_Interface}">
                <StackPanel Margin="15" Background="{DynamicResource WindowBackgroundBrush}">
                    <TextBlock Text="{DynamicResource Settings_Interface}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Language}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="200">
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Notifications}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="NotificationsCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Theme}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="200">
                            <ComboBoxItem Content="{DynamicResource Theme_Light}" Tag="Light"/>
                            <ComboBoxItem Content="{DynamicResource Theme_Dark}" Tag="Dark"/>
                            <ComboBoxItem Content="{DynamicResource Theme_Nexus}" Tag="Nexus"/>
                            <ComboBoxItem Content="{DynamicResource Theme_System}" Tag="System"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_FontSize}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontSizeComboBox" Grid.Column="1" Width="200">
                            <ComboBoxItem Content="{DynamicResource FontSize_Small}" Tag="Small"/>
                            <ComboBoxItem Content="{DynamicResource FontSize_Medium}" Tag="Medium"/>
                            <ComboBoxItem Content="{DynamicResource FontSize_Large}" Tag="Large"/>
                            <ComboBoxItem Content="{DynamicResource FontSize_VeryLarge}" Tag="VeryLarge"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_FontFamily}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontFamilyComboBox" Grid.Column="1" Width="200">
                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                            <ComboBoxItem Content="Arial" Tag="Arial"/>
                            <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                            <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                            <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ==================== ДЕЙСТВИЯ ==================== -->
            <TabItem Header="{DynamicResource Settings_Actions}">
                <StackPanel Margin="15" Background="{DynamicResource WindowBackgroundBrush}">
                    <TextBlock Text="{DynamicResource Settings_Actions}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE710;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="AddProfile_Click"
                                ToolTip="{DynamicResource Action_CreateProfile}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_CreateProfile}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE74D;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="DeleteProfile_Click"
                                ToolTip="{DynamicResource Action_DeleteProfile}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_DeleteProfile}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE74E;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="SaveAll_Click"
                                ToolTip="{DynamicResource Action_SaveAll}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_SaveAll}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE792;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CreateBackup_Click"
                                ToolTip="{DynamicResource Action_CreateBackup}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_CreateBackup}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE896;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="LoadBackup_Click"
                                ToolTip="{DynamicResource Action_LoadBackup}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_LoadBackup}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE749;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="Print_Click"
                                ToolTip="{DynamicResource Action_Print}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Action_Print}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE895;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="Sync_Click"
                                ToolTip="{DynamicResource Main_Sync}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Main_Sync}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ==================== ДОПОЛНИТЕЛЬНО ==================== -->
            <TabItem Header="{DynamicResource Settings_Advanced}">
                <StackPanel Margin="15" Background="{DynamicResource WindowBackgroundBrush}">
                    <TextBlock Text="{DynamicResource Settings_Advanced}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_StartWithWindows}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_MinimizeToTray}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_DataFolder}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DataFolderTextBox"
                                 Grid.Column="1"
                                 Width="230"
                                 Margin="0,0,5,0"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="&#xE838;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="BrowsePath_Click"
                                ToolTip="{DynamicResource Settings_Browse}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AutoSave}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoSaveCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AutoCheckUpdates}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoCheckUpdatesCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_UndoSize}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UndoSizeComboBox"
                                  Grid.Column="1" Width="100">
                            <ComboBoxItem Content="5" Tag="5"/>
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="15" Tag="15"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="25" Tag="25"/>
                            <ComboBoxItem Content="30" Tag="30"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Supabase URL:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SupabaseUrlTextBox" Grid.Column="1" Width="250"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Supabase Key:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SupabaseKeyTextBox" Grid.Column="1" Width="250"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ==================== О ПРОГРАММЕ ==================== -->
            <TabItem Header="{DynamicResource Settings_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15" Background="{DynamicResource WindowBackgroundBrush}">
                    <TextBlock Text="{DynamicResource Settings_About}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="LogBook · Windows" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource About_Description}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <Button Content="{DynamicResource About_Website}" Click="Website_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,15"/>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE897;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="Help_Click"
                                ToolTip="{DynamicResource About_Help}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource About_Help}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Style="{StaticResource ActionRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckUpdateButton"
                                Grid.Column="0" Content="&#xE895;"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CheckUpdate_Click"
                                ToolTip="{DynamicResource About_CheckUpdate}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource About_CheckUpdate}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About_Version}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock x:Name="VersionTextBlock"
                                   Grid.Column="1"
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Btn_OK}"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Click="Ok_Click"/>
            <Button Content="{DynamicResource Btn_Apply}"
                    Width="120" Height="30"
                    Margin="0,0,8,0"
                    Click="Apply_Click"/>
            <Button Content="{DynamicResource Btn_Cancel}"
                    Width="100" Height="30"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>