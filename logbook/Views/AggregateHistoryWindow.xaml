<Window x:Class="logbook.Views.AggregateHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AggHist_Title}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="800" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeMedium}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HistoryCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
        </Style>

        <Style x:Key="ArrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка очистки -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource AggHist_Title}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="ClearHistoryButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    ToolTip="{DynamicResource AggHist_Clear}"
                    Click="ClearHistory_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    Cursor="Hand">
                <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource RedTextBrush}"/>
            </Button>
        </DockPanel>

        <!-- 4 колонки -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ВР-80 -->
                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="{DynamicResource SetupAgg_Vr80}" Style="{StaticResource ColumnHeader}"/>
                    <ItemsControl ItemsSource="{Binding Vr80History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource HistoryCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="↓" Style="{StaticResource ArrowText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- «сейчас» -->
                    <Border Style="{StaticResource HistoryCell}"
                            Background="{DynamicResource AccentBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Vr80Current}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource AggHist_Current}"
                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Та-14 -->
                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="{DynamicResource SetupAgg_Ta14}" Style="{StaticResource ColumnHeader}"/>
                    <ItemsControl ItemsSource="{Binding Ta14History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource HistoryCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="↓" Style="{StaticResource ArrowText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource HistoryCell}"
                            Background="{DynamicResource AccentBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Ta14Current}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource AggHist_Current}"
                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ВК-2500-01 -->
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="{DynamicResource SetupAgg_Vk250001}" Style="{StaticResource ColumnHeader}"/>
                    <ItemsControl ItemsSource="{Binding Vk01History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource HistoryCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="↓" Style="{StaticResource ArrowText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource HistoryCell}"
                            Background="{DynamicResource AccentBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Vk01Current}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource AggHist_Current}"
                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ВК-2500-02 -->
                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="{DynamicResource SetupAgg_Vk250002}" Style="{StaticResource ColumnHeader}"/>
                    <ItemsControl ItemsSource="{Binding Vk02History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource HistoryCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="↓" Style="{StaticResource ArrowText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource HistoryCell}"
                            Background="{DynamicResource AccentBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Vk02Current}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource AggHist_Current}"
                                       FontSize="{DynamicResource AppFontSizeSmall}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка закрыть -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="{DynamicResource AggHist_Close}"
                    Click="OnCloseClick"
                    MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>