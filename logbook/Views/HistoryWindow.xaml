<Window x:Class="logbook.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource History_Title}" Height="520" Width="380"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderCellBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с кнопкой очистки истории -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource History_Title}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="ClearHistoryButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    ToolTip="{DynamicResource History_Clear}"
                    Click="ClearHistory_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    Cursor="Hand">
                <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource RedTextBrush}"/>
            </Button>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource CellBackgroundBrush}">
            <TextBlock x:Name="HistoryText"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="{DynamicResource CellForegroundBrush}"
                       Padding="8"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="{DynamicResource Btn_Close}"
                HorizontalAlignment="Right"
                Padding="20,5"
                Margin="0,10,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>