<Window x:Class="logbook.Views.SetupAggregatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:logbook.Helpers"
        Title="{DynamicResource SetupAgg_Title}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="520" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="{DynamicResource SetupAgg_EnterBoard}"
                   FontSize="14" FontWeight="Bold"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Поле ввода номера борта -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource SetupAgg_Aircraft}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="TxtChast1"
                     TextChanged="OnBoardNumberChanged"/>
            <TextBlock Grid.Column="2"
                       x:Name="StatusChast1"
                       Style="{StaticResource StatusText}"/>
        </Grid>

        <!-- Блок агрегатов (изначально скрыт) -->
        <StackPanel Grid.Row="2" x:Name="AggregatesPanel" Visibility="Collapsed">
            <!-- Агрегаты -->
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource SetupAgg_Vr80}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtVr80"/>
                <TextBlock Grid.Column="2" x:Name="StatusVr80" Style="{StaticResource StatusText}"/>
            </Grid>

            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource SetupAgg_Ta14}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtTa14"/>
                <TextBlock Grid.Column="2" x:Name="StatusTa14" Style="{StaticResource StatusText}"/>
            </Grid>

            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource SetupAgg_Vk01}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtVk01"/>
                <TextBlock Grid.Column="2" x:Name="StatusVk01" Style="{StaticResource StatusText}"/>
            </Grid>

            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource SetupAgg_Vk02}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtVk02"/>
                <TextBlock Grid.Column="2" x:Name="StatusVk02" Style="{StaticResource StatusText}"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    x:Name="ButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <!-- Этап 1 -->
            <Button x:Name="SyncButton"
                    Content="{DynamicResource SetupAgg_Sync}"
                    Click="OnSyncClick"
                    MinWidth="140"
                    Background="{DynamicResource AccentBackgroundBrush}"/>

            <Button x:Name="CancelButton"
                    Content="{DynamicResource Btn_Cancel}"
                    Click="OnCancelClick"
                    MinWidth="110"/>

            <!-- Этап 2 -->
            <Button x:Name="EditButton"
                    Content="{DynamicResource SetupAgg_Edit}"
                    Click="OnEditClick"
                    MinWidth="110"
                    Visibility="Collapsed"/>

            <Button x:Name="ConfirmButton"
                    Content="{DynamicResource SetupAgg_Confirm}"
                    Click="OnConfirmClick"
                    MinWidth="140"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentBackgroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>