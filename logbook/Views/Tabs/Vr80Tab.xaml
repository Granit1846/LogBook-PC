<UserControl x:Class="logbook.Views.Tabs.Vr80Tab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:logbook.Helpers"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource HeaderCellBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="DataCellStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
        </Style>
        <Style x:Key="StartCellStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource StartCellBackgroundBrush}"/>
        </Style>

        <Style x:Key="VerticalText" TargetType="{x:Type TextBlock}">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90"/>
                </Setter.Value>
            </Setter>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderCellForegroundBrush}"/>
            <Setter Property="Effect" Value="{StaticResource HeaderTextShadow}"/>
        </Style>
        <Style x:Key="HorizontalText" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderCellForegroundBrush}"/>
            <Setter Property="Effect" Value="{StaticResource HeaderTextShadow}"/>
        </Style>

        <Style x:Key="TableCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
        </Style>

        <Style x:Key="DataText" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            <Setter Property="helpers:SelectAllOnFocusBehavior.IsEnabled" Value="True"/>
        </Style>
        <Style x:Key="RemoveButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ВЕРХНИЙ БЛОК ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Vr80HeaderScroll"
                          Grid.Column="0"
                          Background="{DynamicResource WindowBackgroundBrush}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          CanContentScroll="False"
                          PreviewMouseWheel="Vr80HeaderScroll_PreviewMouseWheel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="25"/>
                    <RowDefinition Height="Auto" MinHeight="25"/>
                </Grid.RowDefinitions>

                <!-- ================= ШАПКА ================= -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="93"/>
                        <RowDefinition Height="Auto" MinHeight="40"/>
                        <RowDefinition Height="Auto" MinHeight="25"/>
                        <RowDefinition Height="Auto" MinHeight="70"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col0" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col1" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col2" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col3" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col4" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col5" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col6" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col7" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col8" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col9" MinWidth="60"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col10" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col11" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col12" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col13" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col14" MinWidth="30"/>
                    </Grid.ColumnDefinitions>

                    <!-- Уровень 1 -->
                    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Date}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_StartCount}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="2" Grid.ColumnSpan="4" Grid.Row="0" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Style="{StaticResource HorizontalText}" TextAlignment="Center">
                            <Run x:Name="Run_Vr80_GroundWork1"/><LineBreak/>
                            <Run x:Name="Run_Vr80_GroundWork2"/>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="6" Grid.ColumnSpan="3" Grid.Row="0" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Style="{StaticResource HorizontalText}" TextAlignment="Center">
                            <Run x:Name="Run_Vr80_AirWork1"/><LineBreak/>
                            <Run x:Name="Run_Vr80_AirWork2"/>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="9" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Style="{StaticResource HorizontalText}" TextAlignment="Center">
                            <Run x:Name="Run_Vr80_TotalEngine1"/><LineBreak/>
                            <Run x:Name="Run_Vr80_TotalEngine2"/><LineBreak/>
                            <Run x:Name="Run_Vr80_TotalEngine3"/>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="11" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Style="{StaticResource HorizontalText}" TextAlignment="Center">
                            <Run x:Name="Run_Vr80_TotalTurbine1"/><LineBreak/>
                            <Run x:Name="Run_Vr80_TotalTurbine2"/><LineBreak/>
                            <Run x:Name="Run_Vr80_TotalTurbine3"/>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="13" Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Signature}" Style="{StaticResource VerticalText}"/>
                    </Border>

                    <!-- Уровень 2 -->
                    <Border Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_TwoEngines}" Style="{StaticResource HorizontalText}" TextAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_FromTurbine}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="6" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_FullTime}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="7" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_OnModes}" Style="{StaticResource HorizontalText}"/>
                    </Border>
                    <Border Grid.Column="9" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_AfterRepair}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="10" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_SinceOp}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="11" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_AfterRepair}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="12" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_SinceOp}" Style="{StaticResource VerticalText}"/>
                    </Border>

                    <!-- Уровень 3 -->
                    <Border Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_FullTime}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_OnModes}" Style="{StaticResource HorizontalText}"/>
                    </Border>
                    <Border Grid.Column="7" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_Nominal}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="8" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_Takeoff}" Style="{StaticResource VerticalText}"/>
                    </Border>

                    <!-- Уровень 4 -->
                    <Border Grid.Column="3" Grid.Row="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_Nominal}" Style="{StaticResource VerticalText}"/>
                    </Border>
                    <Border Grid.Column="4" Grid.Row="3" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Vr80_Takeoff}" Style="{StaticResource VerticalText}"/>
                    </Border>
                </Grid>

                <!-- ================= БЕЛАЯ СТРОКА ================= -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col0" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col1" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col2" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col3" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col4" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col5" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col6" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col7" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col8" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col9" MinWidth="60"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col10" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col11" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col12" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col13" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col14" MinWidth="30"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Date}" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="{DynamicResource Launch_Label}" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Ground}" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="4" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="5" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="6" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="{DynamicResource Header_Air}" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="8" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="9" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="9" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="24" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="10" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="{DynamicResource Header_SNE}" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="11" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="26" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="12" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="27" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="13" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="28" Style="{StaticResource TableCellText}"/>
                    </Border>
                    <Border Grid.Column="14" Style="{StaticResource DataCellStyle}">
                        <TextBlock Text="" Style="{StaticResource TableCellText}"/>
                    </Border>
                </Grid>

                <!-- ================= СТАРТОВАЯ СТРОКА ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col0" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col1" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col2" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col3" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col4" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col5" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col6" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col7" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col8" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col9" MinWidth="60"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col10" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col11" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col12" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col13" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Col14" MinWidth="30"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Date, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:DateInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.LaunchCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.GroundHours, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col4, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col5, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col6, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col7, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col8, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col9, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="9" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col24, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="10" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.ColSNE, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="11" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col26, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="12" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col27, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="13" Style="{StaticResource StartCellStyle}">
                        <TextBox Text="{Binding Vr80StartRecord.Col28, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBox}"
                                 helpers:TimeInputBehavior.IsEnabled="True"/>
                    </Border>
                    <Border Grid.Column="14" Style="{StaticResource StartCellStyle}"/>
                </Grid>
            </Grid>
            </ScrollViewer>

            <!-- Заглушка над вертикальным скроллбаром таблицы -->
            <Border Grid.Column="1"
                    Width="{x:Static SystemParameters.VerticalScrollBarWidth}"
                    Style="{StaticResource HeaderCellStyle}"/>
        </Grid>

        <!-- ================= ОБЛАСТЬ ДАННЫХ ================= -->
        <ScrollViewer x:Name="Vr80DataScroll"
                      Grid.Row="1"
                      Background="{DynamicResource WindowBackgroundBrush}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Visible"
                      CanContentScroll="False"
                      ScrollChanged="Vr80DataScroll_ScrollChanged"
                      PreviewMouseWheel="Vr80DataScroll_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Vr80Records}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsManualRecalc}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="ToolTip" Value="Необходим ручной пересчет"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinHeight="25">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col0" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col1" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col2" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col3" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col4" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col5" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col6" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col7" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col8" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col9" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col10" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col11" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col12" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col13" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col14" MinWidth="30"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Date}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding LaunchCount}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding GroundHours}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col4}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col5}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col6}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col7}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col8}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="8" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col9}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col24}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="10" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding ColSNE}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="11" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col26}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="12" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col27}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="13" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Col28}" Style="{StaticResource DataText}"/>
                            </Border>

                                <Button Grid.Column="14"
                                    Style="{StaticResource RemoveButtonStyle}"
                                    Command="{Binding DataContext.RemoveVr80RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{DynamicResource Launch_Delete}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>