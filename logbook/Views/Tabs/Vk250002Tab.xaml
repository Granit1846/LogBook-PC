                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col7" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col8" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col9" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col10" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col11" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col12" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col13" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col14" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col15" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col16" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col17" MinWidth="70"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col18" MinWidth="40"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col19" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col20" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col21" MinWidth="60"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Col22" MinWidth="30"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding Date}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding I}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="3" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding G}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="5" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding A}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding A_PPR}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="8" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding B}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="10" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="11" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="12" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="13" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding D}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="14" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="15" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding E}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="16" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="17" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding H}" Style="{StaticResource DataText}"/>
