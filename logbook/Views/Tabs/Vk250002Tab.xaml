                            <Border Grid.Column="18" Style="{StaticResource DataCellStyle}">
                                <TextBlock Text="{Binding H_PPR}" Style="{StaticResource DataText}"/>
                            </Border>
                            <Border Grid.Column="19" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="20" Style="{StaticResource DataCellStyle}"/>
                            <Border Grid.Column="21" Style="{StaticResource DataCellStyle}"/>

                                <Button Grid.Column="22"
                                    Style="{StaticResource RemoveButtonStyle}"
                                    Command="{Binding DataContext.RemoveVk250002RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{DynamicResource Launch_Delete}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
