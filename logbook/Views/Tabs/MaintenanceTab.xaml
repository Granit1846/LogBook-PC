<UserControl x:Class="logbook.Views.Tabs.MaintenanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Работы (регламенты) + История + Синхронизация -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Journal_ScheduledWorks}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Content="{DynamicResource Journal_AddWork}"
                                Command="{Binding AddMaintenanceWorkCommand}"
                                Style="{StaticResource ActionButton}"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScheduledWorks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridLineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Точка статуса -->
                                            <Ellipse Grid.Column="0"
                                                     Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding StatusColorHex}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- Название работы -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource AppFontSize}"/>

                                            <!-- Окно наработки / дней -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource AppFontSize}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding StatusColorHex}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Кнопки внизу левой колонки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Journal_History}"
                        Command="{Binding MaintenanceHistoryCommand}"
                        Style="{StaticResource ActionButton}"/>
                <Button Content="🔄 Синхронизация"
                        Command="{Binding MaintenanceSyncCommand}"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Grid>

        <!-- Правая колонка: Неисправности -->
        <Border Grid.Column="2" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Journal_Defects}"
                               FontWeight="Bold"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="{DynamicResource Journal_AddDefect}"
                            Command="{Binding AddDefectTaskCommand}"
                            Style="{StaticResource ActionButton}"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Заглушка если неисправностей нет -->
                        <TextBlock Text="{DynamicResource Journal_EmptyDefects}"
                                   Foreground="Gray"
                                   FontStyle="Italic"
                                   Margin="4,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleDefects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding VisibleDefects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource GridLineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanCheck}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,2,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource AppFontSize}"/>
                                                <TextBlock Text="{Binding WorkInfo}"
                                                           Foreground="Gray"
                                                           FontSize="{DynamicResource AppFontSizeSmall}"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Выполнено"
                                                           Foreground="Green"
                                                           FontSize="{DynamicResource AppFontSizeSmall}"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>