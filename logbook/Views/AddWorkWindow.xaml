<Window x:Class="logbook.Views.AddWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Journal_AddWork}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="420" Height="360"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Вид работ -->
        <TextBlock Grid.Row="0" Text="{DynamicResource Journal_Kind}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="KindComboBox" Margin="0,0,0,12" Height="30"
                  DisplayMemberPath="Title" SelectedValuePath="Kind"/>

        <!-- Дата и СНЭ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Journal_Date}" Margin="0,0,0,4"/>
                <DatePicker x:Name="WorkDatePicker" Height="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Text="{DynamicResource Journal_Counter}" Margin="0,0,0,4"/>
                <TextBox x:Name="CounterTextBox" Height="30" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Описание -->
        <TextBlock Grid.Row="3" Text="{DynamicResource Journal_Description}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4" x:Name="DescriptionTextBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Journal_Cancel}" Width="90" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Journal_Save}" Width="90" Height="30" Background="{DynamicResource AccentBackgroundBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>