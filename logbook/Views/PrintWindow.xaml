<Window x:Class="logbook.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Title="{DynamicResource Print_Title}"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderCellBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ ЛЕВАЯ ПАНЕЛЬ ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel Margin="5">
                <TextBlock Text="{DynamicResource Print_WhatToPrint}" FontWeight="Bold" Margin="0,5,0,5"/>
                <RadioButton x:Name="CurrentTabRadio" Content="{DynamicResource Print_CurrentTab}"
                             IsChecked="True" Margin="0,2"
                             Checked="Options_Changed"/>
                <RadioButton x:Name="AllTabsRadio" Content="{DynamicResource Print_AllTabs}"
                             Margin="0,2,0,10"
                             Checked="Options_Changed"/>

                <TextBlock Text="{DynamicResource Print_Orientation}"
                           FontWeight="Bold" Margin="0,5,0,10"/>

                <TextBlock Text="{DynamicResource Print_Pages}" FontWeight="Bold" Margin="0,5,0,5"/>
                <ListBox x:Name="PagesListBox" Height="280" Margin="0,0,0,10"
                         SelectionChanged="PagesListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding DisplayName}"
                                      Checked="PageCheck_Changed"
                                      Unchecked="PageCheck_Changed"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{DynamicResource Print_SelectAll}" Click="SelectAll_Click" Margin="0,0,5,0" Width="60"/>
                    <Button Content="{DynamicResource Print_SelectNone}" Click="SelectNone_Click" Width="70"/>
                </StackPanel>

                <TextBlock x:Name="SelectedCountText"
                           Text="{DynamicResource Print_Selected}"
                           Margin="0,5,0,5"/>

                <TextBlock x:Name="PagesInfoText"
                           Text=""
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ ПРАВАЯ ПАНЕЛЬ ============ -->
        <DocumentViewer x:Name="PreviewViewer"
                        Grid.Row="0" Grid.Column="1"
                        Margin="10,0,0,0"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

        <!-- ============ КНОПКИ ============ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,10,0">
            <Button Content="{DynamicResource Action_Print}"
                    Width="120" Height="32"
                    Margin="0,0,8,0"
                    Click="Print_Click"/>
            <Button Content="{DynamicResource Btn_Cancel}"
                    Width="100" Height="32"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>