<Window x:Class="logbook.Views.AddDefectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Journal_AddDefect}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="400" Height="260"
        MinWidth="350" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Journal_Description}" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" x:Name="DescriptionTextBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Journal_Cancel}" Width="90" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Journal_Save}" Width="90" Height="30" Background="{DynamicResource AccentBackgroundBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>