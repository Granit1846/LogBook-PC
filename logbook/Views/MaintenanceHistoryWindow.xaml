<Window x:Class="logbook.Views.MaintenanceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Journal_History}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="700" Height="520"
        MinWidth="550" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна с кнопкой Очистить историю -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Journal_History}"
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="ClearHistoryButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    ToolTip="Очистить историю"
                    Click="ClearHistory_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    Cursor="Hand">
                <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource RedTextBrush}"/>
            </Button>
        </DockPanel>

        <!-- Список истории: Работы и выполненные дефекты -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Раздел: Выполненные работы -->
                <TextBlock Text="{DynamicResource Journal_Works}"
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="EmptyWorksText"
                           Text="{DynamicResource Journal_EmptyWorks}"
                           Foreground="Gray" FontStyle="Italic"
                           Margin="4,0,0,12"/>

                <ItemsControl x:Name="WorksItemsControl" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CellBackgroundBrush}"
                                    BorderBrush="{DynamicResource GridLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding KindTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource AppFontSize}"/>
                                        <TextBlock Text="{Binding Details}"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   Foreground="Gray"
                                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding DescriptionVisibility}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Раздел: Выполненные неисправности -->
                <TextBlock Text="{DynamicResource Journal_CompletedDefects}"
                           FontWeight="Bold" FontSize="14"
                           Margin="0,8,0,8"/>

                <TextBlock x:Name="EmptyDefectsText"
                           Text="{DynamicResource Journal_EmptyHistory}"
                           Foreground="Gray" FontStyle="Italic"
                           Margin="4,0,0,12"/>

                <ItemsControl x:Name="CompletedTasksItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CellBackgroundBrush}"
                                    BorderBrush="{DynamicResource GridLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource AppFontSize}"/>
                                    <TextBlock Text="{Binding WorkInfo}"
                                               Foreground="Gray"
                                               FontSize="{DynamicResource AppFontSizeSmall}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding WorkInfoVisibility}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2"
                Content="{DynamicResource Journal_Close}"
                Width="90" Height="30"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>