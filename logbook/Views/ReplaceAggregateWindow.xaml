<Window x:Class="logbook.Views.ReplaceAggregateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReplaceAgg_Title}"
        Icon="pack://application:,,,/Resources/Icons/logbook.ico"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Старый номер -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource ReplaceAgg_OldNumber}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       x:Name="OldNumberText"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Новый номер -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource ReplaceAgg_NewNumber}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="TxtNewNumber"
                     TextChanged="OnAnyTextChanged"/>
        </Grid>

        <!-- Причина -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource ReplaceAgg_Reason}"
                       VerticalAlignment="Top"
                       Margin="0,5,0,0"/>
            <TextBox Grid.Column="1"
                     x:Name="TxtReason"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="{DynamicResource ReplaceAgg_Cancel}"
                    Click="OnCancelClick"
                    MinWidth="110"/>
            <Button Content="{DynamicResource ReplaceAgg_Confirm}"
                    Click="OnConfirmClick"
                    MinWidth="110"
                    Background="{DynamicResource AccentBackgroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>