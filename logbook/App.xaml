<Application x:Class="logbook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Localization/Lang.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Шрифт -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <sys:Double x:Key="AppFontSize">13</sys:Double>
            <sys:Double x:Key="AppFontSizeSmall">11</sys:Double>
            <sys:Double x:Key="AppFontSizeMedium">13</sys:Double>
            <sys:Double x:Key="AppFontSizeLarge">15</sys:Double>

            <!-- ==================== ОБЩИЙ СТИЛЬ TEXTBOX / PASSWORDBOX ==================== -->
            <Style TargetType="TextBox">
                <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            </Style>

            <!-- ==================== ОБЩИЕ СТИЛИ RADIOBUTTON / CHECKBOX ==================== -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            </Style>

            <!-- ==================== ОБЩИЕ СТИЛИ TABCONTROL/TABITEM ==================== -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="2,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CellBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CellForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>